# videoAcq bot (US) — env file template
#
# Copy to /etc/videoAcq/bot.env on US VPS and edit values.
# After editing: sudo chown 27exe:27exe /etc/videoAcq/bot.env
#                sudo chmod 600 /etc/videoAcq/bot.env

# Dual-VPS toggle: when these two env vars are set, bot uses HK crawler
# instead of local AsyncCamoufox. If either is unset, bot runs the legacy
# single-VPS path (no behavior change from v0.6.5 master code).
CRAWLER_URL=http://127.0.0.1:17650
CRAWLER_BEARER_TOKEN=

# Whether to fall back to local AsyncCamoufox when HK crawler is unreachable.
# Default: 1 (yes). Set to 0 to disable fallback and skip the tick.
FALLBACK_LOCAL_BROWSER=1

# HK crawler client timeout (seconds). Default 60.
CRAWLER_TIMEOUT_SEC=60
