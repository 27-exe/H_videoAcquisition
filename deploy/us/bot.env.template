# videoAcq bot (US) — env file template
#
# Copy to /etc/videoAcq/bot.env on the US VPS and edit values.
# After editing: sudo chown 27exe:27exe /etc/videoAcq/bot.env
#                sudo chmod 600 /etc/videoAcq/bot.env
#
# ⚠️ systemd EnvironmentFile 不支持行内注释:值行必须干净,
#    注释一律独立成行(2026-10-27 实测:行内注释会连值一起读进去,
#    float() 直接 ValueError 把 bot 炸成 failed)。
#
# 2026-10-27: 单 VPS 合并。抓取引擎(crawler 包)与 bot 同进程直调,
# 不再有 HK crawler_service / SSH 反向隧道 / bearer token。
# 已移除的变量:CRAWLER_URL、CRAWLER_BEARER_TOKEN、CRAWLER_TIMEOUT_SEC、
#               FALLBACK_LOCAL_BROWSER(见 git 历史 eca25ea 之前的版本)。

# ── iwara HTTP 抓取路径(curl_cffi + apiq JSON API,主力路径)──────────
# cf_clearance 由本机 camoufox 定期 mint 并写入 config/auth/iwara_auth.json。
# 凭据优先读下面两个 env,未设置(留空)时回退到 config/iwara.yaml 的
# username/password。
IWARA_USERNAME=
IWARA_PASSWORD=
# 1=HTTP 优先(默认);0=仅浏览器路径
IWARA_HTTP_MODE=1
# apiq 详情并发数
IWARA_HTTP_CONCURRENCY=5
# 单请求超时(秒)
IWARA_HTTP_TIMEOUT=25
# TLS 指纹,必须与 camoufox 同属 Firefox 族,否则复用 cf_clearance 会被 CF 拒(403)
IWARA_HTTP_IMPERSONATE=firefox135

# ── hanime1 HTTP 抓取路径(curl_cffi + 服务端渲染 HTML,无需 cookie)────
# 1=HTTP 优先(默认);0=仅浏览器路径
HANIME_HTTP_MODE=1
# 详情页并发数
HANIME_HTTP_CONCURRENCY=5
# 单请求超时(秒)
HANIME_HTTP_TIMEOUT=25
# TLS 指纹,同上必须 Firefox 族
HANIME_HTTP_IMPERSONATE=firefox135

# ── 浏览器(仅 iwara cookie re-mint 与 HTTP 被拦后的罕见兜底)─────────
# 单实例 ~620MB-1GB 峰值;MemoryMax=2G 的 unit 下默认 1 最稳。
MAX_CONCURRENT_BROWSERS=1

# ── 容错阈值 ──────────────────────────────────────────────────────
# iwara CDN 小时级下载配额噪声:按历史基线 1-6 定,避免偶发失败触发整轮重试。
IWARA_MAX_DOWNLOAD_FAILURES=5

# ── 告警 ─────────────────────────────────────────────────────────
# 置 1 可临时静默所有 notify_admin 告警(调试用)。
NOTIFY_DISABLED=0
