[Unit]
Description=US -> HK reverse SSH tunnel for videoAcq crawler
Documentation=https://github.com/27-exe/videoAcquisition
After=network-online.target
Wants=network-online.target
# 2026-09-19: 显式无限重试 —— StartLimitIntervalSec=0 禁用速率限制。HK 宕机
# 恢复后隧道必须自动重连;熔断会让它躺平等人工 reset-failed,成为新的静默故障源。
# 注意:systemd 只认 [Unit] 段的 StartLimit*([Service] 段里会被 ignoring 忽略)。
StartLimitIntervalSec=0

[Service]
Type=simple
User=27exe
Environment=SSH_AUTH_SOCK=/tmp/ssh-agent-27exe
# ExitOnForwardFailure=yes — ssh exits immediately if 8765 unreachable on HK end,
# letting systemd notice and Restart. Without this, ssh -f can succeed without
# listener and tunnel silently dead (only refresh timeout via ServerAlive).
ExecStart=/usr/bin/ssh \
  -N \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -L 127.0.0.1:17650:127.0.0.1:8765 vps
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
